{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"options": {
		"typeAware": true
	},
	"plugins": ["eslint", "typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error"
	},
	"env": {
		"builtin": true
	},
	"ignorePatterns": [
		".claude/**",
		".svelte-kit/**",
		".wrangler/**",
		"wrangler-local-state/**",
		"dist/**",
		"build/**",
		"coverage/**",
		"node_modules/**",
		"playwright-report/**",
		"test-results/**",
		"src/app.d.ts",
		"**/*.svelte"
	],
	"rules": {
		"typescript/no-base-to-string": "warn"
	}
}
