{
	"name": "serialize",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "vite build",
		"build:typecheck": "tsc --noEmit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"fmt": "oxlint --fix && oxfmt",
		"lint": "svelte-kit sync && oxlint && oxfmt --check",
		"preview": "wrangler dev",
		"test": "svelte-kit sync && vitest run",
		"test:ci": "pnpm test:coverage",
		"test:coverage": "svelte-kit sync && vitest run --coverage",
		"test:e2e": "svelte-kit sync && playwright test"
	},
	"dependencies": {
		"@zag-js/collapsible": "^1.45.0",
		"@zag-js/menu": "^1.45.0",
		"@zag-js/slider": "^1.45.0",
		"@zag-js/svelte": "^1.45.0",
		"@zag-js/toggle-group": "^1.45.0",
		"@zag-js/tree-view": "^1.45.0",
		"monaco-editor": "^0.57.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^25.9.9",
		"@vitest/coverage-v8": "^5.0.3",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "^7.0.2003",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.3",
		"wrangler": "^4.149.0"
	},
	"packageManager": "pnpm@12.10.1"
}
