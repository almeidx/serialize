{
	"name": "serialize",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "wrangler deploy",
		"dev": "vite dev",
		"fmt": "oxlint --fix && oxfmt",
		"lint": "svelte-kit sync && oxlint && oxfmt --check",
		"preview": "wrangler dev",
		"test": "svelte-kit sync && vitest run",
		"test:coverage": "svelte-kit sync && vitest run --coverage",
		"test:smoke": "svelte-kit sync && playwright test"
	},
	"dependencies": {
		"@zag-js/menu": "^1.48.0",
		"@zag-js/svelte": "^1.48.0",
		"@zag-js/tree-view": "^1.48.0",
		"monaco-editor": "^0.57.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.1",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2007",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"wrangler": "^4.165.0"
	},
	"packageManager": "pnpm@12.21.0"
}
