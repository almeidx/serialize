{
	"name": "serialize",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"build:typecheck": "tsc --noEmit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"fmt": "oxfmt && oxlint --fix",
		"lint": "oxfmt --check && oxlint --deny-warnings",
		"preview": "wrangler dev",
		"test": "svelte-kit sync && vitest run",
		"test:ci": "pnpm test:coverage",
		"test:coverage": "svelte-kit sync && vitest run --coverage",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@zag-js/collapsible": "^1.41.1",
		"@zag-js/menu": "^1.41.1",
		"@zag-js/slider": "^1.41.1",
		"@zag-js/svelte": "^1.41.1",
		"@zag-js/toggle-group": "^1.41.1",
		"@zag-js/tree-view": "^1.41.1",
		"monaco-editor": "^0.55.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.3",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^25.9.1",
		"@vitest/coverage-v8": "^4.1.7",
		"oxfmt": "^0.52.0",
		"oxlint": "^1.67.0",
		"svelte": "^5.55.10",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.3.0",
		"typescript": "~6.0.3",
		"vite": "^8.0.14",
		"vitest": "^4.1.7",
		"wrangler": "^4.95.0"
	},
	"packageManager": "pnpm@11.4.0"
}
