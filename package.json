{
	"name": "serialize",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"format": "oxfmt --write .github/workflows/ci.yml package.json vite.config.ts src/lib/parser/parse.ts .oxfmtrc.json .oxlintrc.json",
		"format:check": "oxfmt --check .github/workflows/ci.yml package.json vite.config.ts src/lib/parser/parse.ts .oxfmtrc.json .oxlintrc.json",
		"lint": "oxlint . --deny-warnings --vitest-plugin",
		"preview": "vite preview",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@zag-js/collapsible": "^1.34.1",
		"@zag-js/menu": "^1.34.1",
		"@zag-js/slider": "^1.34.1",
		"@zag-js/svelte": "^1.34.1",
		"@zag-js/toggle-group": "^1.34.1",
		"@zag-js/tree-view": "^1.34.1",
		"monaco-editor": "^0.55.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.1",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.53.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.1",
		"@vitest/coverage-v8": "^4.0.18",
		"oxfmt": "^0.35.0",
		"oxlint": "^1.50.0",
		"svelte": "^5.53.3",
		"svelte-check": "^4.4.3",
		"tailwindcss": "^4.2.1",
		"typescript": "~5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18",
		"wrangler": "^4.68.0"
	},
	"packageManager": "pnpm@10.30.2",
	"pnpm": {
		"overrides": {
			"cookie": "^0.7.2"
		}
	}
}
