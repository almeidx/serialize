{
	"name": "serialize",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"build:typecheck": "tsc --noEmit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"fmt": "oxfmt && oxlint --fix",
		"lint": "oxfmt --check && oxlint --deny-warnings",
		"preview": "wrangler dev",
		"test": "svelte-kit sync && vitest run",
		"test:ci": "pnpm test:coverage",
		"test:coverage": "svelte-kit sync && vitest run --coverage",
		"test:e2e": "svelte-kit sync && playwright test"
	},
	"dependencies": {
		"@zag-js/collapsible": "^1.43.3",
		"@zag-js/menu": "^1.43.3",
		"@zag-js/slider": "^1.43.3",
		"@zag-js/svelte": "^1.43.3",
		"@zag-js/toggle-group": "^1.43.3",
		"@zag-js/tree-view": "^1.43.3",
		"monaco-editor": "^0.56.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^25.9.5",
		"@vitest/coverage-v8": "^5.0.0",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.2.2",
		"vitest": "^5.0.0",
		"wrangler": "^4.129.0"
	},
	"packageManager": "pnpm@11.25.0"
}
