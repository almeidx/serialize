{
	"name": "serialize",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"build:typecheck": "tsc --noEmit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"fmt": "oxfmt && oxlint --fix",
		"lint": "oxfmt --check && oxlint --deny-warnings",
		"preview": "wrangler dev",
		"test": "svelte-kit sync && vitest run",
		"test:ci": "pnpm test:coverage",
		"test:coverage": "svelte-kit sync && vitest run --coverage",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@zag-js/collapsible": "^1.42.0",
		"@zag-js/menu": "^1.42.0",
		"@zag-js/slider": "^1.42.0",
		"@zag-js/svelte": "^1.42.0",
		"@zag-js/toggle-group": "^1.42.0",
		"@zag-js/tree-view": "^1.42.0",
		"monaco-editor": "^0.55.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^25.9.5",
		"@vitest/coverage-v8": "^4.1.10",
		"oxfmt": "^0.59.0",
		"oxlint": "^1.74.0",
		"svelte": "^5.56.6",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"wrangler": "^4.112.0"
	},
	"packageManager": "pnpm@11.15.0"
}
